{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {"src":"/$","dest":"/api/root"},
    {"handle":"filesystem"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0"}
      ]
    }
  ]
}
